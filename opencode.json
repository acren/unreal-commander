{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "dotnet-csharp": {
      "command": [
        "pwsh",
        "-NoProfile",
        "-NonInteractive",
        "-CommandWithArgs",
        "$ErrorActionPreference = 'Stop'; dotnet format UnrealCommander.sln --include (Resolve-Path -LiteralPath $args[0] -Relative); exit $LASTEXITCODE",
        "$FILE"
      ],
      "extensions": [
        ".cs"
      ]
    }
  }
}
